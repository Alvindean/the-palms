# Build content source. If these are unset, the build uses /content/*.json
# (the snapshot committed in this repo), so the site always builds & deploys.
# Once Sanity is connected, set these in Vercel -> Project -> Settings -> Environment Variables.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed locally for the one-time `npm run seed` (a write token). NEVER commit a real token.
SANITY_TOKEN=
